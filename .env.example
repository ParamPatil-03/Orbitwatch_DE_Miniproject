# ORBITWATCH – Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── PostgreSQL (admin / superuser) ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orbitwatch
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_admin

# ── PostgreSQL ETL role (read-write, used by the pipeline) ────────────────────
ETL_DB_USER=etl_user
ETL_DB_PASSWORD=change_me_etl

# ── PostgreSQL Dashboard role (read-only, used by Streamlit) ──────────────────
DASHBOARD_DB_USER=dashboard_user
DASHBOARD_DB_PASSWORD=change_me_dashboard

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=mongoadmin
MONGO_PASSWORD=change_me_mongo
MONGO_DB=orbitwatch

# ── Redpanda / Kafka ──────────────────────────────────────────────────────────
# Use the external (host-side) listener when connecting from Python on the host.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

# ── API ───────────────────────────────────────────────────────────────────────
API_KEY=change_me_api_key
